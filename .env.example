# Длину, стратегии, воркеры и RPS удобнее менять в боте через /settings.
# Здесь — только значения по умолчанию для первого запуска.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC...
# Твои Telegram user id через запятую. Если задано — ботом пользуются только они.
ADMIN_IDS=
# Длина юзов (Telegram не даёт занять короче 5). Короткие генерятся чаще.
MIN_LEN=5
MAX_LEN=9
# Сколько проверок идёт параллельно
WORKERS=4
# Общий лимит запросов к t.me в секунду на все воркеры. Словишь 429 — уменьши.
RPS=3
# Какие стратегии генерации включить (по префиксу), пусто = все.
# markov_en markov_it markov_es markov_fr markov_pt markov_fi markov_id markov_tr markov_ru
# markov_mix classical twist blend reverse affix syll_elven syll_dark syll_future syll_soft syll_east
# Пример: STRATEGIES=syll,classical,markov_it
STRATEGIES=
# Файл базы
DB_PATH=us_checker.db

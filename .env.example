# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC...
# Твои Telegram user id через запятую. Если задано — ботом пользуются только они.
ADMIN_IDS=
# Длина юзов (Telegram не даёт занять короче 5)
MIN_LEN=5
MAX_LEN=7
# Пауза между проверками t.me, сек. Меньше 1 — риск словить 429.
CHECK_DELAY=1.5
# Через сколько дней перепроверять уже проверенные юзы
RECHECK_DAYS=7
# Добавлять транслит русских слов (1/0)
INCLUDE_TRANSLIT=1
# Сколько слов брать из частотного словаря wordfreq
WORDFREQ_TOP=60000
# Файл базы
DB_PATH=us_checker.db

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC...
# Твои Telegram user id через запятую. Если задано — ботом пользуются только они.
ADMIN_IDS=
# Длина юзов (Telegram не даёт занять короче 5)
MIN_LEN=5
MAX_LEN=9
# Пауза между проверками t.me, сек. Меньше 1 — риск словить 429.
CHECK_DELAY=1.5
# Через сколько дней перепроверять уже проверенные юзы
RECHECK_DAYS=7
# Источники кандидатов через запятую:
#   styled   — придуманные «изысканные» формы: godeless, incelious, noxelle (основной)
#   premium  — ходовые словарные слова (почти все в резерве у Telegram)
#   translit — транслит русских слов
#   dict     — частотный английский словарь
SOURCES=styled
# Сколько слов брать из словаря wordfreq (для SOURCES=dict)
WORDFREQ_TOP=60000
# Файл базы
DB_PATH=us_checker.db
